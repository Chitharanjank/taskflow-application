pipeline {
  agent any

  tools {
    jdk 'temurin-21'
  }
  
  environment{
     sonarqube_token = credentials('SonarQube-Token')
     DOCKERHUB_CREDS = credentials('DockerHub_cred')
     DOCKERHUB_REPO = "taskflow-app-auth-service"
  }
  
  stages {
     stage ('SonarQube Analysis') {
        steps {
           sh '''
             echo "Sonarqube testing"
             cd auth-service
             docker run --rm   --network host   -e SONAR_HOST_URL="http://localhost:9000"   -e SONAR_TOKEN="$sonarqube_token" -e SONAR_USER_HOME="/tmp/sonar"  -v "$(pwd):/usr/src"   sonarsource/sonar-scanner-cli
           '''
        }
     }

    stage ('test and build') {
      steps {
        sh '''
           cd auth-service
           mvn clean package
        '''
      }
    }

    stage ('Build docker image') {
       steps {
          sh """
             cd auth-service
             docker build -t ${env.DOCKERHUB_CREDS_USR}/${env.DOCKERHUB_REPO}:${env.GIT_COMMIT} .
          """
        }
    }

    stage ('Push to DockerHub') {
            steps {
                sh """
                    echo "Logging into Docker Hub and pushing image..."
                    echo \$DOCKERHUB_CREDS_PSW | docker login -u \$DOCKERHUB_CREDS_USR --password-stdin
                    docker push ${env.DOCKERHUB_CREDS_USR}/${env.DOCKERHUB_REPO}:${env.GIT_COMMIT}
                """
            }
        }
  }
}
