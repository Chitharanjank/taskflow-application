pipeline {
  agent any

  environment {
    DOCKERHUB_REPO = "chitharanjank/taskflow-app-frontend"
  }
  
  stages {
      stage ('build') {
         steps {
           sh '''
             cd frontend
             npm install
             npm run build
           '''
         }
      }

      stage ('create Docker Image') {
        steps {
          sh """
            cd frontend
            docker build -t $DOCKERHUB_REPO:${env.GIT_COMMIT} .
           """
          }
      }
  }
}
