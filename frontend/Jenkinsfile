pipeline {
  agent any

  environment {
    DOCKERHUB_CREDS = credentials('Dockerhubcredential')
    DOCKERHUB_REPO = "${env.DOCKERHUB_CREDS_USR}/taskflow-app-frontend"    
  }
  
  stages {
      stage ('build') {
         steps {
           sh '''
             cd frontend
             npm install
             npm run build
           '''
         }
      }

      stage ('create Docker Image') {
        steps {
          sh """
            cd frontend
            docker build -t $DOCKERHUB_REPO:${env.GIT_COMMIT} .
           """
          }
      }

      stage ('Push to DockerHub') {
        steps {
          sh """
            echo "Logging into Docker Hub and pushing image..."
            echo "\$DOCKERHUB_CREDS_PSW | docker login -u \$DOCKERHUB_CREDS_USR --password-stdin"
            docker push $DOCKERHUB_REPO:${env.GIT_COMMIT}"
            """
        }
      }
  }
}
