pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'temurin-21'
    }

    environment {
        DOCKERHUB_CREDS = credentials('Dockerhubcredential')
        DOCKERHUB_REPO = "taskflow-app-task-service"
    }
    
    stages {
        stage ('Code Quality test') {
            steps {
              sh '''
              cd task-service
              docker run --rm   --network host   -e SONAR_HOST_URL="http://localhost:9000"   -e SONAR_TOKEN="sqa_506fc43b02a4fac39f8b72e394d8a6f58d028c3d" -e SONAR_USER_HOME="/tmp/sonar"  -v "$(pwd):/usr/src"   sonarsource/sonar-scanner-cli
              '''
            }
        }

        stage ('maven compile, test, package') {
            steps {
                sh '''
                cd task-service
                mvn clean package
                '''
            }
        }

        stage ('Build Docker Image') {
            steps {
                sh """
                   docker build -t ${env.DOCKERHUB_CREDS_USR}:${env.DOCKERHUB_REPO}:${env.GIT_COMMIT} .
                """
            }
        }
    }
}
